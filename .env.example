DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aivps
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=false
UPLOAD_DIR=./uploads
# Host folders for docker compose (big videos: keep them off a full system drive)
DATA_DIR=./data
HF_CACHE_DIR=./data/hf-cache
# Behind a fake-IP VPN/proxy (DNS answers 198.18.x.x) links are rejected as
# "private address" — trust that range explicitly (weakens the SSRF guard):
# URL_EXTRA_ALLOWED_NETWORKS=["198.18.0.0/15"]
